{
  // Press F5 to run this extension in an Extension Development Host.
  // The launched window opens .vscode/worktree-manager-dev.code-workspace
  // so the Extension Development Host receives test repositories.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Worktree Manager Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        // Run the dev host in its OWN profile dir so a corrupted webview /
        // service-worker here can never poison your main VSCode install.
        // Wiped before every F5 by the `compile` task (see tasks.json).
        "--user-data-dir=${workspaceFolder}/.vscode/.dev-profile",
        "--profile=dev",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/.vscode/worktree-manager-dev.code-workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "compile"
    }
  ]
}
