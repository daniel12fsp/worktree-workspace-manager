{
  // Dev workspace for the Worktree Workspace Manager extension.
  // The two example bare repos are both workspace folders (so their worktrees
  // are browsable in the Explorer) and managed repositories.
  "folders": [
    {
      "name": "fe-project.git",
      "path": "../../examples-repo/fe-project.git",
    },
    {
      "name": "be-project.git",
      "path": "../../examples-repo/be-project.git",
    },
  ],
  "settings": {
    "worktreeManager.repositories": [
      "~/code/tmp/examples-repo/fe-project.git",
      "~/code/tmp/examples-repo/be-project.git",
    ],
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      ".bare": true,
      ".bare/**": true,
      "**/.bare": true,
      "**/.bare/**": true,
      ".bare.git": true,
      ".bare.git/**": true,
      "**/.bare.git": true,
      "**/.bare.git/**": true,
      "/mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/code/tmp/examples-repo/fe-project.git/.bare": true,
      "/mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/code/tmp/examples-repo/fe-project.git/.bare/**": true,
      "/mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/code/tmp/examples-repo/be-project.git/.bare": true,
      "/mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/code/tmp/examples-repo/be-project.git/.bare/**": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      ".bare": true,
      ".bare/**": true,
      "**/.bare": true,
      "**/.bare/**": true,
      ".bare.git": true,
      ".bare.git/**": true,
      "**/.bare.git": true,
      "**/.bare.git/**": true,
      "/mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/code/tmp/examples-repo/fe-project.git/.bare": true,
      "/mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/code/tmp/examples-repo/fe-project.git/.bare/**": true,
      "/mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/code/tmp/examples-repo/be-project.git/.bare": true,
      "/mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/code/tmp/examples-repo/be-project.git/.bare/**": true
    },
    // files.exclude / search.exclude are managed PER FOLDER at runtime (written
    // into each repo's .vscode/settings.json), so basename patterns scope to a
    // single repo and never collide across repos. Nothing global is committed.
  },
}
